{
  "name": "codex-anydevice",
  "displayName": "Codex AnyDevice",
  "description": "Prepare personal QQ direct access to Codex with secure credentials and one-project setup.",
  "version": "0.2.1",
  "publisher": "Young581",
  "license": "MIT",
  "preview": true,
  "engines": { "vscode": "^1.96.0", "node": ">=22" },
  "categories": ["Other"],
  "keywords": ["codex", "mobile", "qq", "wechat"],
  "repository": { "type": "git", "url": "https://github.com/Young581/codex-anydevice.git" },
  "homepage": "https://github.com/Young581/codex-anydevice#readme",
  "bugs": { "url": "https://github.com/Young581/codex-anydevice/issues" },
  "main": "./extension/extension.js",
  "activationEvents": ["onStartupFinished"],
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false },
    "virtualWorkspaces": { "supported": false }
  },
  "contributes": {
    "commands": [
      { "command": "codexAnyDevice.openSetup", "title": "%command.openSetup%", "category": "Codex AnyDevice" },
      { "command": "codexAnyDevice.checkEnvironment", "title": "%command.checkEnvironment%", "category": "Codex AnyDevice" },
      { "command": "codexAnyDevice.openResearch", "title": "%command.openResearch%", "category": "Codex AnyDevice" },
      { "command": "codexAnyDevice.showStatus", "title": "%command.showStatus%", "category": "Codex AnyDevice" }
    ],
    "configuration": {
      "title": "Codex AnyDevice",
      "properties": {
        "codexAnyDevice.codexPath": { "type": "string", "default": "", "scope": "machine", "description": "%config.codexPath%" }
      }
    }
  },
  "scripts": {
    "check": "node scripts/check.js",
    "test": "node --test tests/extension.test.js tests/setup.test.js tests/runtime.test.js",
    "package": "python -B build.py --output dist"
  }
}
